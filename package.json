{
  "name": "tf-template",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:deps": "node scripts/install-deps.mjs",
    "start:sast": "npm --prefix sast/backend start",
    "dev:sast": "npm --prefix sast/backend run dev",
    "start:pentest": "npm --prefix pentest/backend start",
    "dev:pentest": "npm --prefix pentest/backend run dev",
    "start:target": "npm --prefix pentest/backend run target",
    "aws:credentials": "node scripts/aws-credentials.mjs",
    "build:job-api": "npm --prefix lambda/job-api run build",
    "terraform:shared": "terraform -chdir=terraform/shared",
    "terraform:apps": "npm run build:job-api && terraform -chdir=terraform/apps"
  },
  "devDependencies": {
    "bestzip": "4.0.3"
  }
}
